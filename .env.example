# PostgreSQL Database Configuration
# Copy this file to .env and update with your credentials

POSTGRES_DB=readsphere
POSTGRES_USER=user1
POSTGRES_PASSWORD=12345
POSTGRES_PORT=5432

# pgAdmin Configuration
PGADMIN_EMAIL=user1@pgadmin.com
PGADMIN_PASSWORD=12345
PGADMIN_PORT=5050

# Database Connection String (for application use)
DATABASE_URL=postgresql://user1:12345@localhost:5432/readsphere
